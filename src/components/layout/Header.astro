---
import type { Locale } from "../../utils/site";
import { localePath } from "../../utils/site";
import { getNavigation } from "../../data/navigation";
import { links } from "../../data/links";
import { t } from "../../i18n/ui";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const nav = getNavigation(locale);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={localePath(locale, "/")} aria-label={t(locale, "homeAria")}>
      <span>Antonii Sarychev</span>
    </a>
    <nav class="main-nav" aria-label={t(locale, "primaryNavigation")}>
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="actions">
      <LanguageSwitcher locale={locale} />
      <a class="contact" href={links.github}>{t(locale, "github")}</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid rgba(31, 31, 35, 0.78);
    background: rgba(10, 10, 11, 0.84);
    backdrop-filter: blur(16px);
  }

  .header-inner {
    display: flex;
    min-height: 66px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    color: var(--text);
    font-weight: 800;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .main-nav,
  .actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .main-nav a,
  .contact {
    color: var(--muted-2);
    font-size: 0.92rem;
  }

  .contact {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.4rem 0.65rem;
  }

  @media (max-width: 760px) {
    .header-inner {
      flex-wrap: wrap;
      padding: 0.8rem 0;
    }

    .main-nav {
      order: 3;
      width: 100%;
      justify-content: space-between;
    }

    .actions {
      gap: 0.5rem;
    }
  }
</style>
