---
interface Props {
  href: string;
  variant?: "primary" | "secondary";
  label?: string;
}

const { href, variant = "secondary", label } = Astro.props;
---

<a class:list={["btn", variant]} href={href} aria-label={label}>
  <slot />
</a>

<style>
  .btn {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    padding: 0.7rem 1rem;
    font-weight: 700;
    line-height: 1;
    transition: border-color 160ms ease, background 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .primary {
    border: 1px solid rgba(245, 166, 35, 0.75);
    background: var(--accent);
    color: #120d03;
  }

  .primary:hover {
    color: #120d03;
    background: var(--accent-2);
  }

  .secondary {
    border: 1px solid var(--border-strong);
    background: rgba(255, 255, 255, 0.025);
    color: var(--text);
  }

  .secondary:hover {
    border-color: rgba(245, 166, 35, 0.45);
  }
</style>
