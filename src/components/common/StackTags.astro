---
import Badge from "./Badge.astro";

interface Props {
  stack: string[];
  limit?: number;
}

const { stack, limit } = Astro.props;
const tags = limit ? stack.slice(0, limit) : stack;
---

<div class="stack" aria-label="Technology stack">
  {tags.map((item) => <Badge label={item} />)}
</div>

<style>
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
</style>
