---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/home/Hero.astro";
import ProofStrip from "../../components/home/ProofStrip.astro";
import Capabilities from "../../components/home/Capabilities.astro";
import SelectedWork from "../../components/home/SelectedWork.astro";
import Workflow from "../../components/home/Workflow.astro";
import BusinessAutomation from "../../components/home/BusinessAutomation.astro";
import NowTeaser from "../../components/home/NowTeaser.astro";
import ContactCTA from "../../components/home/ContactCTA.astro";

const locale = "ru";
const work = (await getCollection("work", ({ data }) => data.lang === locale && data.featured))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Антоний Сарычев - AI/LLM-разработчик и AI Integration Engineer"
  description="AI/LLM-разработчик: AI-агенты, MCP-инструменты, RAG-пайплайны, обработка документов и async backend."
  lang={locale}
  path="/ru/"
>
  <Hero locale={locale} />
  <ProofStrip locale={locale} />
  <Capabilities locale={locale} />
  <SelectedWork locale={locale} items={work} />
  <Workflow locale={locale} />
  <BusinessAutomation locale={locale} />
  <NowTeaser locale={locale} />
  <ContactCTA locale={locale} />
</BaseLayout>
