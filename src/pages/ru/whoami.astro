---
import BaseLayout from "../../layouts/BaseLayout.astro";

const locale = "ru";
---

<BaseLayout title="whoami - Антоний Сарычев" description="Terminal-style профиль Антония Сарычева." lang={locale} path="/ru/whoami/">
  <section class="section">
    <div class="container">
      <h1 class="sr-only">whoami</h1>
      <div class="terminal whoami" role="region" aria-label="Terminal profile">
        <pre><code>$ whoami
antonii-sarychev

$ role
AI/LLM Developer · AI Integration Engineer

$ builds
ai-agents
mcp-tools
rag-pipelines
document-ai
async-backends
business-mvps

$ workflow
research -> ТЗ -> agent implementation -> review -> tests -> deploy

$ contact
github: Apartman36
x: apartmanchik
telegram: @apartman36
email: Sae230704@yandex.ru</code></pre>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  .whoami {
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(1rem, 4vw, 2rem);
  }

  pre {
    margin: 0;
    overflow: auto;
    color: var(--code-green);
    font-family: var(--mono);
    font-size: clamp(0.9rem, 2vw, 1.1rem);
    line-height: 1.75;
  }
</style>
